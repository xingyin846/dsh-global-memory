{
  "name": "@xxmy/dsh-global-memory",
  "version": "0.31.1-gm.3",
  "description": "global_memory: DeepSeek Harness 插件（meow-memory 0.31.1 的 fork）——跨工作区共享同一个 SQLite 记忆库、首轮只注入用户习惯与全局准则（带字符上限）、三层遗忘（检索降权/注入截断/归档 curator）、审计版本表与房间可见性。",
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "memory", "agent-memory", "project-memory", "sqlite"],
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "lib/prompts/**",
    "cordis.patch.yml",
    "tools/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": { "type": "git", "url": "git+https://github.com/xingyin846/dsh-global-memory.git" },
  "homepage": "https://github.com/xingyin846/dsh-global-memory",
  "bugs": { "url": "https://github.com/xingyin846/dsh-global-memory/issues" },
  "license": "MIT",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "scripts": {
    "patch": "node tools/patch.mjs",
    "test": "node tools/verify.mjs"
  }
}
